<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>电池温度</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>显示</string>
			<key>footerText</key>
			<string>在桌面/锁屏状态栏的电池图标正下方，显示实时的电池温度（°C）与电压（V），每 3 秒刷新。换过电池、系统隐藏温度时也能看真实读数。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.yzdmm.batterytemp</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>启用温度显示</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>实时调节</string>
			<key>footerText</key>
			<string>改动即时生效，回到桌面即可看到效果。用 - / + 微调显示位置与大小。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStepperCell</string>
			<key>defaults</key>
			<string>com.yzdmm.batterytemp</string>
			<key>key</key>
			<string>vGap</string>
			<key>label</key>
			<string>温度 高度</string>
			<key>default</key>
			<real>8</real>
			<key>min</key>
			<real>0</real>
			<key>max</key>
			<real>40</real>
			<key>step</key>
			<real>1</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStepperCell</string>
			<key>defaults</key>
			<string>com.yzdmm.batterytemp</string>
			<key>key</key>
			<string>hOffset</string>
			<key>label</key>
			<string>温度 左右</string>
			<key>default</key>
			<real>0</real>
			<key>min</key>
			<real>-80</real>
			<key>max</key>
			<real>80</real>
			<key>step</key>
			<real>1</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStepperCell</string>
			<key>defaults</key>
			<string>com.yzdmm.batterytemp</string>
			<key>key</key>
			<string>vOffset</string>
			<key>label</key>
			<string>温度 上下</string>
			<key>default</key>
			<real>0</real>
			<key>min</key>
			<real>-20</real>
			<key>max</key>
			<real>80</real>
			<key>step</key>
			<real>1</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStepperCell</string>
			<key>defaults</key>
			<string>com.yzdmm.batterytemp</string>
			<key>key</key>
			<string>fontSize</string>
			<key>label</key>
			<string>温度 大小</string>
			<key>default</key>
			<real>13</real>
			<key>min</key>
			<real>8</real>
			<key>max</key>
			<real>40</real>
			<key>step</key>
			<real>1</real>
		</dict>
	</array>
</dict>
</plist>